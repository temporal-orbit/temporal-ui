{
	"name": "temporal-ui",
	"version": "0.9.4",
	"private": true,
	"description": "Monorepo for Temporal UI Design System (React, Solid bindings)",
	"license": "MIT",
	"author": "Temporal",
	"repository": {
		"type": "git",
		"url": "https://github.com/temporal-app/temporal-ui.git"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"postinstall": "lefthook install",
		"build": "turbo run build",
		"clean": "turbo run clean && rimraf node_modules .turbo",
		"test": "turbo run test",
		"react": "cd packages/react && bun run storybook",
		"solid": "cd packages/solid && bun run storybook",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"typecheck": "turbo run typecheck",
		"check": "turbo run check",
		"changeset": "bunx @changesets/cli",
		"version": "bunx @changesets/cli version",
		"publish": "bun run build && bunx @changesets/cli publish"
	},
	"devDependencies": {
		"@temporal-ui/solid": "workspace:*",
		"@types/bun": "1.3.14",
		"@types/node": "25.9.1",
		"@typescript/native-preview": "7.0.0-dev.20260603.1",
		"jsdom": "29.1.1",
		"lefthook": "2.1.9",
		"oxfmt": "0.53.0",
		"oxlint": "1.68.0",
		"rimraf": "6.1.3",
		"turbo": "2.9.14",
		"typescript": "6.0.3"
	},
	"packageManager": "bun@1.3.12",
	"trustedDependencies": [
		"@tailwindcss/oxide"
	]
}
