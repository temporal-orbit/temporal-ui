{
	"name": "@temporal-ui/react",
	"version": "0.9.1",
	"description": "React bindings for Temporal UI components",
	"bugs": {
		"url": "https://github.com/temporal-app/temporal-ui/issues"
	},
	"license": "MIT",
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./hooks/*": {
			"types": "./dist/hooks/*/index.d.ts",
			"import": "./dist/hooks/*/index.js",
			"default": "./dist/hooks/*/index.js"
		},
		"./utils/*": {
			"types": "./dist/utils/*/index.d.ts",
			"import": "./dist/utils/*/index.js",
			"default": "./dist/utils/*/index.js"
		},
		"./*": {
			"types": "./dist/components/*/index.d.ts",
			"import": "./dist/components/*/index.js",
			"default": "./dist/components/*/index.js"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown && node ../../scripts/copy-core-styles.mjs",
		"dev": "bun run storybook",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ci": "vitest run",
		"clean": "rimraf dist node_modules .turbo",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsgo --noEmit",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"prepack": "node ../../scripts/replace-protocols.mjs",
		"postpublish": "node ../../scripts/restore-protocols.mjs"
	},
	"dependencies": {
		"@ark-ui/react": "5.37.0",
		"@tanstack/react-table": "8.21.3",
		"@temporal-ui/core": "workspace:*"
	},
	"devDependencies": {
		"@storybook/addon-docs": "10.4.2",
		"@storybook/addon-themes": "10.4.2",
		"@storybook/react-vite": "10.4.2",
		"@tailwindcss/vite": "4.3.0",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/react": "19.2.16",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.2",
		"happy-dom": "20.9.0",
		"lucide-react": "1.17.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"rimraf": "6.1.3",
		"storybook": "10.4.2",
		"tailwindcss": "4.3.0",
		"tsdown": "0.22.1",
		"typescript": "6.0.3",
		"vite": "8.0.16",
		"vitest": "4.1.8"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	}
}
